# Medical Faculty Agent — environment variables
# Copy this file to `.env` and adjust as needed.

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Ollama generation options (passed through to /api/chat)
OLLAMA_NUM_GPU_LAYERS=35
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.0

# --- Search provider (optional) ---
# DuckDuckGo HTML is used by default; provide a SerpAPI key to upgrade later.
SEARCH_API_KEY=

# --- Crawler defaults ---
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; MedicalFacultyAgent/0.1; +https://example.org/bot)
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_DOMAIN=100
CRAWLER_TIMEOUT_MS=30000
CRAWLER_DELAY_SECONDS=1.5
CRAWLER_MAX_RETRIES=2

# --- Database ---
DATABASE_URL=sqlite:///data/database/faculty.db

# --- Pipeline ---
PIPELINE_RUN_ID=
PIPELINE_RESUME=false